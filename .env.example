# StockSense Environment Configuration
# Copy this file to .env and adjust values as needed.

# API Server port (default: 3001)
API_PORT=3001

# Frontend dev server port (default: 5173)
PORT=5173

# Database — leave blank to use built-in PGlite (no PostgreSQL needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/stocksense

# JWT Secret (change this in production!)
JWT_SECRET=stocksense-local-dev-secret-2026

# Node environment
NODE_ENV=development
